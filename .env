
# ==========================================
# DJANGO CONFIGURATION
# ==========================================
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False

# ==========================================
# POSTGRESQL CONFIGURATION
# ==========================================
DB_NAME=shopguard_db
DB_USER=shopguard_user
DB_PASSWORD=YourStrongLocalPassword123
DB_HOST=postgres
DB_PORT=5432

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TIMEOUT=300

# Redis authentication
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Dedicated Redis database for rate limiting
RATE_LIMIT_REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/2
